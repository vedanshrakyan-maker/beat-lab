# ---------------------------------------------------------------------------
# ReelPay local development environment. Copy to .env: `cp .env.example .env`
# Every external service defaults to a MOCK. No real API keys are needed.
# The keys below are DEV-ONLY placeholders; production refuses to boot with them.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reelpay?schema=public"
# Used by `npm test` (integration tests reset this database).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reelpay_test?schema=public"

# development | test | staging | production. Production refuses dev keys and dev login.
APP_ENV="development"
APP_URL="http://localhost:3000"
# Auth.js secret. Generate a real one with: npx auth secret
AUTH_SECRET="dev-only-auth-secret-change-me-0000000000000000"
AUTH_TRUST_HOST="true"
# Dev-only "sign in as seeded user" switcher. Never enable in production.
ALLOW_DEV_LOGIN="true"

# AES-256-GCM key for PAN / UPI / OAuth tokens (base64, 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE="

# --- Platforms: "mock" (default) or "live" ---------------------------------
YOUTUBE_ADAPTER="mock"
YOUTUBE_API_KEY=""
YOUTUBE_DAILY_QUOTA="10000"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

INSTAGRAM_ADAPTER="mock"
IG_APP_ID=""
IG_APP_SECRET=""
IG_GRAPH_API_VERSION="v23.0"

# --- Payments: "mock" (default) or "razorpay" ------------------------------
PAYMENTS_PROVIDER="mock"
MOCK_WEBHOOK_SECRET="dev-only-mock-webhook-secret"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAYX_ACCOUNT_NUMBER=""

# --- Email: "console" (default) or "smtp" ----------------------------------
EMAIL_PROVIDER="console"
EMAIL_FROM="ReelPay <no-reply@reelpay.local>"
SMTP_URL=""
